<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔔 도전! 독서 골든벨 🔔</title>
    <style>
        /* 1. 화면 세로 크기를 100vh로 고정하여 스크롤 차단 */
        body { 
            font-family: 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif; 
            background: radial-gradient(circle, #ffeb3b 10%, #fbc02d 90%);
            text-align: center; 
            margin: 0; 
            padding: 2vh 2vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            box-sizing: border-box;
            overflow: hidden; 
        }

        /* 2. 대형 컨테이너 박스 (기존 비율 유지) */
        .container { 
            width: 98%;
            max-width: 1400px; 
            height: 94vh; 
            background: rgba(255, 255, 255, 0.98); 
            padding: 3vh 4vw; 
            border-radius: 40px; 
            box-shadow: 0 25px 60px rgba(230, 124, 0, 0.3); 
            border: 8px solid #e65100; 
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: space-between; 
            position: relative;
        }

        /* 3. 첫 화면 전용 스타일 (1.png 이미지로 전체 화면 꽉 채우기) */
        .intro-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            height: 100%;
            width: 100%;
            overflow: hidden;
            border-radius: 30px; /* 대형 박스 안쪽 둥글기에 맞춤 */
        }

        /* 첫 화면 메인 이미지 (첫 화면 영역을 100% 꽉 채움) */
        .main-img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* 이미지가 찌그러지지 않고 영역을 가득 채우도록 설정 */
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }
        
        /* 작고 깔끔하게 다듬은 시작 버튼 (오른쪽 아래 배치) */
        .btn-start-next {
            position: absolute;
            bottom: 20px;
            right: 20px;
            padding: 12px 28px;
            font-size: 1.4rem;
            font-weight: 900;
            color: white;
            background: linear-gradient(135deg, #ffca28, #ff8f00);
            border: 3px solid #ffffff;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 5px 0 #e65100, 0 8px 15px rgba(230, 81, 0, 0.3);
            transition: all 0.1s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 2; /* 이미지 위로 올라오도록 설정 */
        }
        .btn-start-next:hover {
            transform: translateY(1px);
            box-shadow: 0 4px 0 #e65100, 0 6px 12px rgba(230, 81, 0, 0.3);
        }
        .btn-start-next:active {
            transform: translateY(5px);
            box-shadow: 0 0px 0 #e65100, 0 2px 5px rgba(230, 81, 0, 0.2);
        }

        /* 4. 퀴즈 플레이 화면 스타일 */
        .header-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            border-bottom: 3px dashed #ffe082;
            padding-bottom: 1.5vh;
            flex-shrink: 0;
        }
        .quiz-type { 
            display: inline-block; 
            padding: 1vh 3vw; 
            background: linear-gradient(135deg, #d32f2f, #b71c1c); 
            color: #ffffff; 
            font-weight: 900; 
            font-size: 1.8rem; 
            border-radius: 50px; 
            box-shadow: 0 6px 15px rgba(0,0,0,0.2);
            border: 3px solid #fff;
        }
        .top-nav { display: flex; gap: 15px; }
        .btn-mini {
            width: 60px; height: 60px; font-size: 1.8rem; border: 2px solid #fff;
            border-radius: 50%; color: white; cursor: pointer; display: flex;
            justify-content: center; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            transition: all 0.2s;
        }
        .btn-mini:hover { transform: scale(1.1); }
        .btn-answer { background: linear-gradient(135deg, #ff9800, #e65100); }
        .btn-next { background: linear-gradient(135deg, #4caf50, #1b5e20); }

        .question { 
            font-size: 3.8rem; margin: 2vh 0; font-weight: 800; color: #1a2a6c; line-height: 1.5; 
            word-break: keep-all; letter-spacing: -1px; flex-grow: 1; display: flex;
            align-items: center; justify-content: center; 
        }
        .choices { display: flex; flex-direction: column; gap: 2vh; align-items: center; width: 100%; flex-shrink: 0; }
        .choice-item { 
            width: 100%; max-width: 1200px; padding: 2.5vh 4vw; font-size: 2.6rem; border: 4px solid #ef6c00; 
            border-radius: 24px; background: #fff8e1; color: #d84315; text-align: center; font-weight: 800; 
            box-shadow: 0 6px 0 #e65100, 0 8px 15px rgba(0,0,0,0.05); box-sizing: border-box;
            user-select: none; pointer-events: none; transition: all 0.3s ease;
        }
        .choice-item.is-correct {
            background: linear-gradient(135deg, #ebfbee, #d3f9d8) !important; border-color: #2b8a3e !important;
            color: #2b8a3e !important; box-shadow: 0 6px 0 #2b8a3e, 0 8px 20px rgba(43, 138, 62, 0.3) !important;
            transform: scale(1.02);
        }
        .answer-box { 
            position: absolute; bottom: 3vh; left: 50%; transform: translateX(-50%); width: 90%; max-width: 1200px;
            font-size: 3.8rem; color: #b71c1c; font-weight: 900; padding: 2.5vh; background: #ffebee; 
            border-radius: 25px; display: none; border: 5px dashed #d32f2f; box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            box-sizing: border-box; z-index: 10; animation: popUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes popUp {
            0% { transform: translate(-50%, 20px) scale(0.9); opacity: 0; }
            100% { transform: translate(-50%, 0) scale(1); opacity: 1; }
        }
    </style>
</head>
<body>

<div class="container" id="quiz-container">
    
    <div id="intro-view" class="intro-content">
        <img src="1.png" alt="도전 골든벨" class="main-img">
        
        <button class="btn-start-next" onclick="startQuiz()">시작</button>
    </div>

    <div id="quiz-view" style="display: none; flex-direction: column; justify-content: space-between; height: 100%; width: 100%;">
        <div class="header-box">
            <div class="quiz-type" id="quiz-type">로딩중</div>
            <div class="top-nav">
                <button class="btn-mini btn-answer" onclick="showAnswer()" title="정답 확인">🔔</button>
                <button class="btn-mini btn-next" onclick="nextQuestion()" title="다음 문제">▶</button>
            </div>
        </div>
        
        <div class="question" id="question-text">문제를 불러오는 중입니다...</div>
        <div class="choices" id="choices-area"></div>
        <div class="answer-box" id="answer-text">정답 ✨: </div>
    </div>
</div>

<script>
    // 『아미동 아이들』 독서 골든벨 문제 리스트
    const quizData = [
        // 1단계: 쉬움
        { tag: "1단계", type: "주관식", q: "책 제목의 빈칸에 들어갈 말은 무엇인가요?\n『○○동 아이들』", a: "아미" },
        { tag: "1단계", type: "주관식", q: "아미동은 어느 도시에 있나요?", a: "부산" },
        { tag: "1단계", type: "O/X", q: "이 이야기는 6·25 전쟁 때 피난 온 사람들의 이야기이다.", choices: ["① O", "② X"], a: "① O" },
        { tag: "1단계", type: "객관식", q: "순동이네와 동수네가 처음 천막을 친 곳은 어디인가요?", choices: ["① 바닷가", "② 공동묘지", "③ 학교 운동장", "④ 기차역"], a: "② 공동묘지" },
        { tag: "1단계", type: "주관식", q: "순동이와 순식, 순호가 걸린 병의 이름을 쓰세요.", a: "홍역" },
        { tag: "1단계", type: "객관식", q: "동수와 동수 할아버지의 고향은 어디인가요?", choices: ["① 영천", "② 안동", "③ 경주"], a: "① 영천" },
        { tag: "1단계", type: "O/X", q: "동수는 과자 굽는 기술을 아주 느리게 배웠다.", choices: ["① O", "② X"], a: "② X" },
        { tag: "1단계", type: "객관식", q: "이야기에 나오는 일본 여자아이의 이름은 무엇인가요?", choices: ["① 하나코", "② 사쿠라", "③ 유키"], a: "② 사쿠라" },
        { tag: "1단계", type: "객관식", q: "동수가 읽다가 잠드는 바람에 천막에 불이 났습니다. 동수가 읽던 동화책은 무엇인가요?", choices: ["① 백설공주", "② 신데렐라", "③ 흥부와 놀부"], a: "② 신데렐라" },
        { tag: "1단계", type: "주관식", q: "피난민들이 먹고 싶다고 한 죽은 무엇인가요? (초성 힌트: ㅍㅈ)", a: "팥죽" },
        { tag: "패자부활", type: "O/X", q: "천막에 불이 난 것은 동수가 책을 읽다가 잠들었기 때문이다.", choices: ["① O", "② X"], a: "① O" },
        // 2단계: 보통
        { tag: "2단계", type: "주관식", q: "순동이네와 동수네가 천막을 친 공동묘지는 어느 나라 사람들의 묘지였나요?", a: "일본" },
        { tag: "2단계", type: "주관식", q: "피난민들은 묘지에 있던 무엇을 가져다 집을 짓는 데 썼나요?", a: "비석" },
        { tag: "2단계", type: "주관식", q: "동수의 아버지는 어떤 일을 했나요?", a: "짐 나르는 일" },
        { tag: "2단계", type: "주관식", q: "동수는 누구와 함께 다니려고 야간학교에 다닌다고 했나요?", a: "순동이" },
        { tag: "2단계", type: "객관식", q: "순호가 홍역에 걸린 뒤 순동이네는 어떤 집을 지었나요?", choices: ["① 초가집", "② 기와집", "③ 판잣집"], a: "③ 판잣집" },
        { tag: "2단계", type: "주관식", q: "사쿠라 할아버지의 성은 무엇인가요?", a: "나카무라" },
        { tag: "2단계", type: "객관식", q: "동수의 종기를 낫게 하려고 할아버지는 어디에 떡을 놓았나요?", choices: ["① 부엌", "② 변소 앞", "③ 대문 앞"], a: "② 변소 앞" },
        { tag: "2단계", type: "주관식", q: "할아버지는 동수의 종기가 낫기를 며칠 동안 빌었나요?", a: "백 일" },
        { tag: "2단계", type: "주관식", q: "동수와 순동이는 도둑을 잡고 무엇을 받았나요?", a: "과자" },
        { tag: "2단계", type: "주관식", q: "동수가 고향에 돌아가 차리겠다고 한 가게의 이름은 무엇인가요?", a: "동수 과자 가게" },
        { tag: "패자부활", type: "객관식", q: "순동이의 손자 이름은 무엇인가요?", choices: ["① 민수", "② 민구", "③ 민호"], a: "② 민구" },
        // 3단계: 어려움
        { tag: "3단계", type: "주관식", q: "사쿠라는 순동이에게 할아버지의 비석을 어떻게 해 달라고 부탁했나요?", a: "뒤집어 놓아 달라고 했다." },
        { tag: "3단계", type: "주관식", q: "사쿠라가 할아버지의 비석을 뒤집어 놓아 달라고 부탁한 까닭은 무엇인가요?", a: "나중에 알아보기 위해서" },
        { tag: "3단계", type: "주관식", q: "이야기에서 죽을 때 머리를 고향 쪽으로 돌린다고 한 동물은 무엇인가요?", a: "여우" },
        { tag: "3단계", type: "객관식", q: "여우 이야기와 뜻이 통하는, '고향을 그리워하는 마음'을 나타내는 사자성어는 무엇인가요?", choices: ["① 수구초심", "② 일석이조", "③ 금상첨화"], a: "① 수구초심" },
        { tag: "3단계", type: "주관식", q: "동수가 떠난 뒤 동수네 집에 이사 온 아이들 가운데, 동수와 닮은 셋째 아이의 이름은 무엇인가요?", a: "명철(명철이)" },
        { tag: "3단계", type: "주관식", q: "동수는 순호에게 구두를 몇 켤레 지어 준다고 했나요?", a: "한 켤레" },
        { tag: "3단계", type: "주관식", q: "일어난 순서대로 기호를 쓰세요.\n㉠ 순호가 홍역에 걸린다.\n㉡ 공동묘지에 천막을 친다.\n㉢ 판잣집을 짓는다.", a: "㉡ → ㉠ → ㉢" },
        { tag: "패자부활", type: "O/X", q: "사쿠라 할아버지의 비석은 순동이네가 사는 묘지에 있었다.", choices: ["① O", "② X"], a: "① O" },
        // 마지막 골든벨
        { tag: "골든벨", type: "주관식", q: "피난민들이 비석 위에 집을 짓고 살았던 지금의 아미동 마을은 무엇이라고 불리나요?", a: "비석문화마을" },
        { tag: "골든벨", type: "주관식", q: "동수와 동수 할아버지가 함께 그리워한 곳은 어디이며, 동수는 그곳에서 무엇을 하고 싶어 했나요?", a: "영천, 과자 가게 차리기" },
        { tag: "골든벨", type: "주관식", q: "순동이가 형과 함께 한 일과, 동수가 일한 곳을 모두 쓰세요.", a: "구두닦기(구두 수선), 과자 가게" }
    ];

    let currentIndex = 0;

    // 화면 전환 함수
    function startQuiz() {
        document.getElementById("intro-view").style.display = "none";
        document.getElementById("quiz-view").style.display = "flex";
        loadQuiz();
    }

    function loadQuiz() {
        if (quizData.length === 0) return;
        const currentQuiz = quizData[currentIndex];
        
        document.getElementById("quiz-type").innerText = `🏆 문제 ${currentIndex + 1} / ${quizData.length} (${currentQuiz.tag ? currentQuiz.tag + " · " : ""}${currentQuiz.type})`;
        document.getElementById("question-text").innerText = currentQuiz.q;
        
        document.getElementById("answer-text").style.display = "none";
        document.getElementById("answer-text").innerText = "정답 ✨ : " + currentQuiz.a;

        const choicesArea = document.getElementById("choices-area");
        
        if(currentQuiz.choices) {
            choicesArea.style.display = "flex";
            choicesArea.innerHTML = "";
            
            currentQuiz.choices.forEach(choice => {
                choicesArea.innerHTML += `<div class="choice-item" data-text="${choice.trim()}">${choice.trim()}</div>`;
            });
        } else {
            choicesArea.style.display = "none";
        }
    }

    function showAnswer() {
        const currentQuiz = quizData[currentIndex];
        
        if(currentQuiz.choices) {
            const correctAnswerText = currentQuiz.a.replace(/^[①②③④]\s*/, "").trim(); 
            const choiceItems = document.querySelectorAll(".choice-item");
            
            choiceItems.forEach(item => {
                const itemText = item.getAttribute("data-text");
                if(itemText && itemText.includes(correctAnswerText)) {
                    item.classList.add("is-correct");
                }
            });
        } else {
            document.getElementById("answer-text").style.display = "block";
        }
    }

    function nextQuestion() {
        if(currentIndex < quizData.length - 1) {
            currentIndex++;
            loadQuiz();
        } else {
            alert("축하합니다! 모든 문제를 다 풀었습니다. 명예의 전당에 등극했습니다! 🔔🏆");
        }
    }
</script>
</body>
</html>
